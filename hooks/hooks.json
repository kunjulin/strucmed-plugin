{
  "description": "strucmed：使用者訊息提到病人資料、帳密、直連倉儲、上架或刪除時注入安全提醒（不阻擋）；線上寫入第二段呼叫前檢查閘門 G3 的核准 sidecar；online_login 密碼錯誤時提示使用者以 /plugin configure 更新密碼；寫入後把結果追加到 <workspace>/.strucmed/workflow-log.md（本機、無外送，STRUCMED_NO_LOG=1 關閉）",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/prompt-reminder.js"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_strucmed_strucmed__online_(template_create|template_update|dictionary_create|dictionary_batch)",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/validate-gate.js"], "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_strucmed_strucmed__online_login",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/auth-reminder.js"], "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__plugin_strucmed_strucmed__online_(template_create|template_update|dictionary_create|dictionary_batch|records_save)",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/log-write.js"], "timeout": 20 }
        ]
      }
    ]
  }
}
