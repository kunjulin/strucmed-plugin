{
  "name": "strucmed",
  "version": "3.2.0",
  "description": "長庚結構化病歷 2.0（StrucMed）表單製作 plugin（Codex 版 manifest）：與使用者互動設計表單、離線驗證與 runtime 預覽、經 strucmed API v2 上架、LlmGateway 模型白名單、表單 APP 產生。站台自動判斷院內／院外；線上功能以瀏覽器登入站台，HIS 密碼只在站台登入頁輸入，不經 AI 工具與對話。",
  "author": {
    "name": "Kunjulin"
  },
  "repository": "https://github.com/kunjulin/strucmed-plugin",
  "keywords": [
    "strucmed",
    "cgmh",
    "structured-medical-record",
    "form-builder",
    "mcp"
  ],
  "skills": "./skills",
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "strucmed": {
      "command": "node",
      "args": ["./mcp/strucmed-mcp/src/server.mjs"],
      "cwd": ".",
      "env_vars": [
        "PWD",
        "STRUCMED_WORKSPACE",
        "STRUCMED_SITE",
        "STRUCMED_EXTERNAL_URL",
        "STRUCMED_NO_BROWSER",
        "STRUCMED_LOGIN_WAIT_MS",
        "LLMGW_API_KEY",
        "FMAPI_API_KEY",
        "STRUCMED_RUNTIME_WEB"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 180
    }
  },
  "interface": {
    "displayName": "StrucMed",
    "shortDescription": "長庚結構化病歷 2.0 表單製作",
    "developerName": "Kunjulin",
    "category": "healthcare"
  }
}
